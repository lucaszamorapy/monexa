generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TransactionType {
  Despesa
  Entrada
}

enum TransactionCategory {
  Alimentação
  Aluguel
  Contas
  Educação
  Lazer
  Moradia
  Outros
  Saúde
  Transporte
  Salário
  Investimentos
}

enum TransactionSituation {
  Pago
  Pendente
}

enum TransactionPaymentMethod {
  Pix
  Débito
  Crédito
}

model Transactions {
  transactionId       String                   @id @default(uuid())
  userId              String
  transactionFatherId String?
  type                TransactionType
  paymentMethod       TransactionPaymentMethod
  category            TransactionCategory
  amount              Float
  totalAmountIntallment Float?
  installment         Int?
  installmentNumber   Int?
  date                DateTime                 @db.Date
  description         String?
  situation           TransactionSituation
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                Users                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  father              Transactions?            @relation("TransactionHierarchy", fields: [transactionFatherId], references: [transactionId], onDelete: Cascade)
  children            Transactions[]           @relation("TransactionHierarchy")
}

model Users {
  userId           String    @id @default(uuid())
  email            String    @unique
  name             String
  image            String?
  password         String
  codeVerification Int?
  expirationAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transactions[]
}
